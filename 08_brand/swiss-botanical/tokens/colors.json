      },
      "surfacePressed": {
        "value": "{color.primitive.paperPressed}"
      },
      "surfaceInverse": {
        "value": "{color.primitive.ink}"
      },
      "textPrimary": {
        "value": "{color.primitive.ink}"
      },
      "textSecondary": {
        "value": "{color.primitive.inkSecondary}"
      },
      "textMetadata": {
