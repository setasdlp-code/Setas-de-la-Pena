    "modes": {
      "archive": {
        "value": "#5A3725",
        "type": "color",
        "role": "Modo Archive: memoria micol\u00f3gica, pliego y taxonom\u00eda."
      },
      "field": {
        "value": "#5B6B44",
        "type": "color",
        "role": "Modo Field: cultivo, micelio y procesos biol\u00f3gicos."
      },
      "control": {
        "value": "#5E7080",
        "type": "color",
        "role": "Modo Control: telemetr\u00eda, lotes y trazabilidad inmutable."
