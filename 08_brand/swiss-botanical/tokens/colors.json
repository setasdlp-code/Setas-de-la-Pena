      },
      "textInverse": {
        "value": "{color.primitive.inkInverse}"
      },
      "borderHairline": {
        "value": "{color.primitive.lineHairline}"
      },
      "borderStrong": {
        "value": "{color.primitive.lineStrong}"
      },
      "borderHeavy": {
        "value": "{color.primitive.lineHeavy}"
      },
      "accentShiitake": {
        "value": "{color.species.shiitake}"
      },
      "accentOrellana": {
        "value": "{color.species.orellana}"
      },
      "accentMelena": {
        "value": "{color.species.melena}"
      },
      "accentRosa": {
        "value": "{color.species.rosa}"
      },
      "statusOk": {
