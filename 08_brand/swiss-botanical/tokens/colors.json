      "forest": {
        "value": "#4A3C31",
        "type": "color",
        "role": "Perfil sotobosque y tierra andina."
      },
      "mineral": {
        "value": "#5E7080",
        "type": "color",
        "role": "Perfil mineral y niebla fresca."
      },
      "golden": {
        "value": "#9D6F28",
        "type": "color",
        "role": "Perfil miel silvestre y notas de nuez."
      }
    }
  }
}
