    },
    {
      "paragraphId": "P00039",
      "path": "tabs.t.0.body.content[39]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4472,
      "endIndex": 4473,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
