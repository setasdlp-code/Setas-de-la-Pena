// Security Rules — Setas OS (sdlp-os)
//
// Cómo desplegar (no lo hace el agente — requiere tu cuenta de Firebase):
//   0) Ejecuta el comando desde `field-os-simulador/setas-os/`, donde viven
//      el único `firebase.json` canónico y el alias de proyecto `.firebaserc`.
//   1) npm install -g firebase-tools
//   2) firebase login
//   3) firebase deploy --only firestore:rules --project sdlp-os
//   (o pega este archivo directamente en Firebase Console → Firestore Database → Reglas)
//
// Defensa en profundidad: el cliente (simulador.html) ya bloquea Guardar/Ejecutar
// lote si la receta no suma 100% (±0.5%). Estas reglas repiten esa validación en
// el servidor para que ni un bug del cliente ni una escritura manual puedan saltarla.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    // Tolerancia idéntica a MASS_BALANCE_TOL en simulador.html y db.js.
    // Recalcula la suma real de ingredientes[].pct en vez de confiar en un campo
    // `tot` autoreportado por el cliente — si solo se validara `tot`, cualquier
    // escritura manual (fuera del cliente) podría declarar tot:100 con una mezcla
    // que en realidad no suma 100%, saltándose por completo esta defensa.
    function getPct(ingredientes, i) {
      return i < ingredientes.size() && ingredientes[i].pct is number ? ingredientes[i].pct : 0.0;
    }
    function masaBalanceada(ingredientes) {
      let tot = getPct(ingredientes, 0) + getPct(ingredientes, 1) + getPct(ingredientes, 2)
              + getPct(ingredientes, 3) + getPct(ingredientes, 4) + getPct(ingredientes, 5)
              + getPct(ingredientes, 6) + getPct(ingredientes, 7);
      return tot >= 99.5 && tot <= 100.5;
    }

    match /usuarios/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /recetas/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.ingredientes is list
        && masaBalanceada(request.resource.data.ingredientes);
      allow delete: if isAdmin();
    }

    match /lotes_produccion/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.recetaSnapshot.ingredientes is list
        && masaBalanceada(request.resource.data.recetaSnapshot.ingredientes)
        // recetaSnapshot se escribe una sola vez, al crear el lote — nunca se edita.
        ;
      allow update: if signedIn()
        && request.resource.data.recetaSnapshot == resource.data.recetaSnapshot
        && (!('status' in request.resource.data) || request.resource.data.status is string);
      allow delete: if isAdmin();
    }

    match /inventario_lotes/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /incidencias_climaticas/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /telemetria_lecturas/{id} {
      allow read: if signedIn();
      // `source` es un campo controlado por el cliente, no una credencial:
      // permitirlo como bypass hacía posible que cualquiera escribiera datos
      // climáticos falsos. El adaptador ESP32 usa el endpoint LAN; la
      // persistencia en Firestore ocurre desde la aplicación autenticada.
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /telemetria_salas/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /bitacora_lotes/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /bitacora_bolsas/{id} {
      allow read: if signedIn();
      // foto (data URL base64) debe eliminarse antes de guardar (ver bitacora-sync.js)
      // para no inflar la base de datos de Firestore.
      allow write: if signedIn() && !('foto' in request.resource.data);
    }
    match /bitacora_cosechas/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Catálogo de ingredientes — de solo lectura para todos los operadores,
    // solo un admin lo edita (evita que un error de captura rompa el formulador).
    match /ingredientes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Ficha pública de trazabilidad (QR en etiquetas térmicas, ver
    // firebase/public-trace-sync.js) — lectura sin autenticar para
    // cualquiera que escanee el código impreso en una bolsa/lote.
    // Solo guarda un subconjunto saneado del lote: nunca costos, proveedores,
    // ni la fórmula/receta completa (eso vive en lotes_produccion, protegido).
    //
    // Escritura: no basta con signedIn() — eso deja que cualquier sesión
    // autenticada (incluida una robada) escriba lo que quiera en una
    // colección de lectura pública. Se restringe a:
    //   - isAdmin(): reutiliza el rol que ya existe en usuarios/{uid}.rol
    //     (cero infraestructura nueva, funciona hoy mismo).
    //   - isSyncService(): custom claim sync_service==true en el token de
    //     Auth. Es el mecanismo pensado para las cuentas operativas que
    //     ejecutan public-trace-sync.js — hay que asignarlo antes de
    //     desplegar estas reglas (ver firebase/scripts/asignar-sync-claim.js)
    //     o esas cuentas dejarán de poder sincronizar la ficha pública.
    function isSyncService() {
      return signedIn() && request.auth.token.sync_service == true;
    }

    function puedeEscribirPublico() {
      return isAdmin() || isSyncService();
    }

    function camposPublicosSeguros(data) {
      let prohibidos = ['costo', 'cost', 'costoIngKg', 'proveedor', 'recetaSnapshot', 'receta', 'operador', 'notas'];
      return !(data.keys().hasAny(prohibidos));
    }

    // true si el campo no viene en el documento, o si viene y cumple el tipo/tamaño.
    function esStringOpcional(data, campo, maxLen) {
      return !(campo in data) || (data[campo] is string && data[campo].size() <= maxLen);
    }
    function esEnteroOpcionalEnRango(data, campo, minVal, maxVal) {
      return !(campo in data)
        || (data[campo] is int && data[campo] >= minVal && data[campo] <= maxVal);
    }
    function esNumeroOpcionalEnRango(data, campo, minVal, maxVal) {
      return !(campo in data)
        || (data[campo] is number && data[campo] >= minVal && data[campo] <= maxVal);
    }

    match /public_lotes/{codigo} {
      allow read: if true;

      allow create, update: if puedeEscribirPublico()
        && camposPublicosSeguros(request.resource.data)
        && esStringOpcional(request.resource.data, 'codigo', 64)
        && esStringOpcional(request.resource.data, 'especie', 128)
        && esStringOpcional(request.resource.data, 'especieCientifico', 128)
        && esStringOpcional(request.resource.data, 'fechaInoculacion', 32)
        && esStringOpcional(request.resource.data, 'estado', 32)
        && esEnteroOpcionalEnRango(request.resource.data, 'numBolsas', 0, 100000);

      allow delete: if puedeEscribirPublico();

      match /cosechas/{cosechaId} {
        allow read: if true;

        allow create, update: if puedeEscribirPublico()
          && camposPublicosSeguros(request.resource.data)
          && esStringOpcional(request.resource.data, 'fecha', 32)
          && esNumeroOpcionalEnRango(request.resource.data, 'pesoFresco', 0, 10000000)
          && esEnteroOpcionalEnRango(request.resource.data, 'calidad', 0, 5)
          && esEnteroOpcionalEnRango(request.resource.data, 'flush', 1, 1000);

        allow delete: if puedeEscribirPublico();
      }
    }

    // Monitoreo de errores del cliente (ver firebase/error-monitor.js) — cada
    // operador puede reportar sus propios errores, pero no leer los de otros
    // ni modificar/borrar el historial (evita que un error mal-intencionado
    // se use para tapar reportes previos).
    match /app_errors/{id} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
