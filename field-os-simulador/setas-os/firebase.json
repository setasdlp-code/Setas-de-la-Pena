{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/l/**", "destination": "/public/trace.html" },
      { "source": "/c/**", "destination": "/public/trace.html" },
      { "source": "/trace/**", "destination": "/public/trace.html" }
    ]
  }
}
